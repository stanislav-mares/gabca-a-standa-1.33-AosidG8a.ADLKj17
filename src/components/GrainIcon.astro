---
import { Image } from "astro:assets";
import grain from "../assets/grain.svg";

interface Props {
    /** Rozestupy okolo ikony. Výchozí hodnota sedí na patičku podstránek —
     *  ikona odděluje konec obsahu, takže drží `--spacing-section` jako
     *  ostatní předěly. Na stránkách, jejichž kontejner má `gap-section`,
     *  ten odstup dodává rovnou mřížka a předává se jen `mb-section`,
     *  jinak by se sčítaly. V Headeru je rozestup vlastní (`shrink-0`). */
    class?: string;
}

const { class: className = "mt-section mb-section" } = Astro.props;

// Ryze dekorativní prvek — pro čtečky neexistuje (aria-hidden + prázdný alt).
// `<Image>` místo inline SVG: soubor má 29 kB a je na sedmi stránkách, takže
// se vyplatí ho mít jako jeden cachovaný požadavek místo sedmi kopií v HTML.
---

<div class:list={["flex justify-center", className]} aria-hidden="true">
    {/* Rozměry v atributech drží poměr 720:1024 a odpovídají největší
        vykreslené velikosti; nahoru se stejně škáluje vektor, takže se
        nemá co rozmazat. Samotnou velikost řídí třídy. */}
    <Image
        src={grain}
        alt=""
        width={56}
        height={80}
        class="w-9 md:w-11 lg:w-12 2xl:w-14 h-auto"
    />
</div>
