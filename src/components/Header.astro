---
import { Image } from "astro:assets";
import Logo from "./Logo.astro";
import Menu from "./Menu.astro";
import GrainIcon from "./GrainIcon.astro";
import CountDown from "./CountDown.astro";
import CeremonyDate from "./CeremonyDate.astro";
import podnadpis from "../assets/podnadpis.png";
---

<header
    id="main-header"
    class="h-full flex flex-col items-center justify-start content-center w-full p-cluster bg-surface"
>
            {/* mt-auto tady a mb-auto na obalu menu: volné místo se rozdělí
                na půl nad logo a pod menu, takže je celá skupina svisle na
                střed. Auto-margin navíc při přetečení spadne na nulu, kdežto
                justify-center by odsunul horní okraj mimo dosah scrollu.
                Až od sm — pod ním je panel přes celou stránku a obsah
                začíná nahoře. */}
            <div class="w-full flex items-center shrink-0 sm:mt-auto">
                <button
                    id="header-logo-btn"
                    type="button"
                    class="w-full cursor-pointer"
                    aria-label="Zpět na úvod"
                >
                    <Logo
                        width={840}
                        maxHeight="min(50svh, 500px)"
                        maxWidth="50%"
                    />
                    {/* Uvnitř tlačítka schválně: dědí tím fade-in po dosednutí
                        letícího loga i vypnutí přechodů v skipIntro(). Musí
                        zůstat za logem — Intro bere první <img> v headeru jako
                        cíl přeletu. Eager, protože header startuje odsunutý
                        mimo viewport a lazy by obrázek dotáhl až po vjezdu. */}
                    <Image
                        src={podnadpis}
                        alt="Gabča & Standa — 26. září 2026"
                        loading="eager"
                        class="w-full h-auto py-cluster"
                    />
                </button>
            </div>
            <div
                class="w-full min-h-0 flex flex-col overflow-y-auto overscroll-contain sm:mb-auto"
            >
                <div class="mx-auto flex flex-col items-center">
                    <Menu />
                </div>
            </div>
            <GrainIcon class="mt-section absolute bottom-2" />

    <!-- <div class="flex justify-center items-end"> -->
        <!-- <Logo width="160" height="160" layout="constrained" /> -->
    <!-- </div> -->
    <!-- <div class="h-1/3 flex items-stretch justify-center">
       <CountDown targetDate="2026-09-26T23:59:59" />
    </div> -->
</header>

<style>
    /* Schovaný vlevo, dokud ho Intro při odchodu nepustí dovnitř (.header-entered) */
    #main-header {
        transform: translateX(-100%);
        transition: transform 1.2s ease-in-out;
    }

    #main-header.header-entered {
        transform: none;
    }

    /* Protějšek skrytí intra po refreshi (viz Intro.astro): header i logo
       jsou vidět hned, než skipIntro() přidá stavové třídy */
    :global(html.intro-seen) #main-header:not(.header-entered) {
        transform: none;
        transition: none;
    }

    :global(html.intro-seen)
        #main-header:not(.header-entered)
        #header-logo-btn {
        opacity: 1;
        transition: none;
    }

    /* Letící logo zůstává viditelné (80 %) i po dosednutí; headerové
       se pod ním objeví až po konci letu (1.2s) a jen ho „doostří"
       na 100 %. Při odletu naopak zhasne hned (bez delay). */
    #header-logo-btn {
        opacity: 0;
        transition: opacity 0.3s ease-out;
    }

    #main-header.header-entered #header-logo-btn {
        opacity: 1;
        transition: opacity 0.3s ease-in 1.2s;
    }
</style>
