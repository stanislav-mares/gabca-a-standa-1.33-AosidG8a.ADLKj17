---
import { Image } from "astro:assets";
import Logo from "./Logo.astro";
import Menu from "./Menu.astro";
import GrainIcon from "./GrainIcon.astro";
import CountDown from "./CountDown.astro";
import CeremonyDate from "./CeremonyDate.astro";
import podnadpis from "../assets/podnadpis.png";
---

{/* Scrolluje celý panel, ne jen menu. Na nízkém okně (telefon na šířku) se
    logo s podnadpisem do výšky nevejde a dřív ukrojilo místo menu až na nulu —
    položky pak nešlo vůbec zobrazit. Takhle si každý blok drží svou velikost
    a při přetečení se panel prostě odscrolluje.

    Scroll je ale záchranná brzda pro opravdu nízká okna, ne běžný stav: každý
    svislý rozměr uvnitř panelu se odvozuje od šířky (`vw` škály), takže na FHD
    vycházel pořád stejně — obsah měřil 994 px a do maximalizovaného okna
    (~880–940 px viewportu) se nevešel. Proto má každý `svh` strop; ten se
    uplatní jen tam, kde je okno na svou šířku nízké, a na vysokém okně je
    neviditelný, protože volné místo stejně rozdělují auto-marginy níž. */}
<header
    id="main-header"
    class="h-full flex flex-col items-center justify-start content-center w-full px-cluster py-[min(var(--spacing-cluster),3.5svh)] bg-surface overflow-y-auto overscroll-contain"
>
            {/* mt-auto tady a mb-auto na obalu menu: volné místo se rozdělí
                na půl nad logo a pod menu, takže je celá skupina svisle na
                střed. Auto-margin navíc při přetečení spadne na nulu, kdežto
                justify-center by odsunul horní okraj mimo dosah scrollu. */}
            <div class="w-full flex items-center shrink-0 mt-auto">
                <button
                    id="header-logo-btn"
                    type="button"
                    class="w-full cursor-pointer"
                    aria-label="Zpět na úvod"
                >
                    {/* Zpožděný fade visí na tomhle obalu, ne na celém
                        tlačítku — jinak by za logem čekal i podnadpis, který
                        má naskočit hned. */}
                    <div id="header-logo">
                        {/* Fluidní strop drží od FHD nahoru konstantních 13.7 %
                            šířky okna, takže proporce vypadá stejně na FHD, 2K
                            i 4K; nad 4K se růst zastaví. Pod FHD strop nezasahuje
                            a rozhoduje maxWidth. Výškový strop je 26svh: logo je
                            největší blok panelu, takže se na nízkém okně krátí
                            jako první (dřív tu bylo 50svh, což na FHD nikdy
                            nezasáhlo — 468 px proti 263 px z šířkového stropu). */}
                        <Logo
                            width={840}
                            maxHeight="min(26svh, clamp(263px, 13.7vw, 525px))"
                            maxWidth="50%"
                        />
                    </div>
                    {/* Uvnitř tlačítka schválně: klikatelný je tím celý blok
                        včetně podnadpisu. Musí zůstat za logem — Intro bere
                        první <img> v headeru jako cíl přeletu. Eager, protože
                        header startuje odsunutý mimo viewport a lazy by
                        obrázek dotáhl až po vjezdu. */}
                    <Image
                        src={podnadpis}
                        alt="Gabča & Standa — 26. září 2026"
                        loading="eager"
                        class="w-full max-w-[clamp(511px,26.6vw,1020px)] mx-auto h-auto py-[min(var(--spacing-cluster),3svh)]"
                        data-reveal
                        style="--reveal-delay: 1.3s"
                    />
                </button>
            </div>
            {/* shrink-0: menu si drží plnou výšku i v přetečeném panelu.
                Bez toho by se smrsklo místo toho, aby se panel odscrolloval. */}
            <div class="w-full shrink-0 flex flex-col mb-auto">
                <div class="mx-auto flex flex-col items-center">
                    <Menu />
                </div>
            </div>
            {/* V toku, ne `absolute`: díky `mb-auto` na obalu menu zůstane
                u spodku panelu, ale při přetečení se odscrolluje spolu
                s položkami menu místo aby je překryla. */}
            {/* Poslední v kaskádě náběhu: položky menu jedou po 0.08s a ta
                poslední startuje v 1.77s (viz Menu.astro), ikona tedy
                navazuje stejným krokem. */}
            <GrainIcon
                class="mt-[min(var(--spacing-section),4svh)] shrink-0"
                data-reveal
                style="--reveal-delay: 1.85s"
            />

    <!-- <div class="flex justify-center items-end"> -->
        <!-- <Logo width="160" height="160" layout="constrained" /> -->
    <!-- </div> -->
    <!-- <div class="h-1/3 flex items-stretch justify-center">
       <CountDown targetDate="2026-09-26T23:59:59" />
    </div> -->
</header>

<style>
    /* Reveal (viz global.css) patří jen k příchodu z Intra — třídu nasazuje
       enterMain(). Po refreshi i po návratu z podstránky panel rovnou stojí,
       takže se animace vůbec nenasadí a prvky se vykreslí normálně.
       Zapnutím třídy se animation-name mění z `none`, a přesně tím animace
       startuje: delaye se tedy počítají od kliknutí na „Vstoupit". */
    #main-header:not(.header-revealing) :global([data-reveal]) {
        animation: none;
    }

    /* Posun položek o 1rem dolů se počítá do scrollovací oblasti panelu, takže
       by na dobu animace naskočil scrollbar a jeho šířka by cukla obsahem.
       Třídu sundá Intro hned po doběhnutí revealu, pak se scroll vrátí. */
    #main-header.header-revealing {
        overflow: hidden;
    }

    /* Schovaný vlevo, dokud ho Intro při odchodu nepustí dovnitř (.header-entered) */
    #main-header {
        transform: translateX(-100%);
        transition: transform 1.2s ease-in-out;
    }

    #main-header.header-entered {
        transform: none;
    }

    /* Protějšek skrytí intra po refreshi (viz Intro.astro): header i logo
       jsou vidět hned, než skipIntro() přidá stavové třídy */
    :global(html.intro-seen) #main-header:not(.header-entered) {
        transform: none;
        transition: none;
    }

    :global(html.intro-seen) #main-header:not(.header-entered) #header-logo-btn,
    :global(html.intro-seen) #main-header:not(.header-entered) #header-logo {
        opacity: 1;
        transition: none;
    }

    /* Dvojí gate: tlačítko se prolíná rovnou s vjezdem panelu, čímž drží
       odchodový fade i pro podnadpis (ten si nástup načasuje sám svým
       revealem, do té doby ho schová `both` fill)… */
    #header-logo-btn {
        opacity: 0;
        transition: opacity 0.3s ease-out;
    }

    #main-header.header-entered #header-logo-btn {
        opacity: 1;
        transition: opacity 0.3s ease-in;
    }

    /* …zatímco logo uvnitř čeká na konec letu. Letící logo zůstává viditelné
       (80 %) i po dosednutí; headerové se pod ním objeví až po 1.2s a jen ho
       „doostří" na 100 %. Při odletu naopak zhasne hned (bez delay). */
    #header-logo {
        opacity: 0;
        transition: opacity 0.3s ease-out;
    }

    #main-header.header-entered #header-logo {
        opacity: 1;
        transition: opacity 0.3s ease-in 1.2s;
    }
</style>
