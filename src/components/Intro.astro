---
import Logo from "./Logo.astro";
import { Image } from "astro:assets";
import introBackground from "../assets/dkr-1795-bw.jpg";
---

<div
    id="intro-overlay"
    class="fixed inset-0 z-20 flex items-center  overflow-hidden"
>
    <!-- Podklad pod fotkou — musí se prolínat s ostatními vrstvami,
         kořen overlaye zůstává průhledný -->
    <div class="intro-bg absolute inset-0 bg-surface"></div>
    <!-- Stejný scale/origin jako fotka pozadí v Layout.astro, aby na sebe navazovaly -->
    <Image
        src={introBackground}
        alt=""
        widths={[768, 1280, 1920, 2799]}
        sizes="100vw"
        format="webp"
        loading="eager"
        class="intro-bg absolute inset-0 w-full h-full object-cover scale-130 origin-[0%_50%]"
    />
    <!-- Jemný přechod pro čitelnost loga nad fotkou -->
    <div
        class="intro-bg absolute inset-0 bg-gradient-to-r from-surface/90 via-surface/40 to-transparent"
    >
    </div>
    {/* Od 1300px poloviční šířka u levého okraje = skupina logo + tlačítko
        sedí na čtvrtině šířky stránky, posunutá o 10 % dolů. Pod prahem je na
        střed a o 25 % níž, čímž její střed padne na 75 % výšky, tedy doprostřed
        spodní poloviny (menší logo z media query se tam vejde celé).
        Samotný posun je ve stylu níž (.intro-group) — potřebuje se zastropovat
        zbývajícím místem, na což třídy nestačí.
        Translate patří kontejneru — do .intro-logo sahá skript přeletu. */}
    <div
        class="intro-group relative w-full min-[1300px]:w-1/2 flex flex-col items-center justify-center gap-block"
    >
        <div class="intro-logo opacity-35">
            <Logo width={1200} size="var(--intro-logo)" />
        </div>
        <button
            class="intro-enter font-alexbrush text-hero text-text/35 hover:text-text cursor-pointer"
            aria-label="Vstoupit na web">Vstoupit</button
        >
    </div>
</div>

<style>
    /* Velikost loga. Je čtvercové, takže svh strop je zároveň stropem výšky;
       90vw je pojistka pro úzká okna, kde by se ta výška do šířky nevešla.
       Pod prahem 1300px je logo menší, aby se celá skupina s tlačítkem vešla
       do spodní poloviny okna (viz translate u kontejneru). */
    #intro-overlay {
        --intro-logo: min(33svh, 90vw);
    }

    /* Svislý posun skupiny pod střed okna. Strop drží „Vstoupit" nad dolním
       okrajem: `100%` v translate měří samotnou skupinu, a protože je
       vycentrovaná, je `(100svh - 100%) / 2` přesně vzdálenost od její
       aktuální pozice k dolnímu okraji okna. Bez toho se na nízkých oknech
       (telefon na šířku) tlačítko ořízlo — a odscrollovat to nejde, overlay je
       `fixed` a jako úvodní obrazovka scrollovat nemá. Počítá se to samo z
       aktuálních rozměrů, takže tu není žádný breakpoint na uhádnutí. */
    .intro-group {
        --intro-shift: 25svh;
        transform: translateY(
            min(var(--intro-shift), calc((100svh - 100%) / 2 - 1rem))
        );
    }

    @media (min-width: 1300px) {
        #intro-overlay {
            --intro-logo: min(55.33svh, 90vw);
        }

        .intro-group {
            --intro-shift: 10svh;
        }
    }

    /* Uživatel už intrem prošel (html třídu nastavuje blokující skript
       v Layoutu): schovej overlay hned, než ho skipIntro() usadí —
       jinak intro po refreshi bliklo. Po usazení (.intro-leaving)
       pravidlo přestává platit. */
    :global(html.intro-seen) #intro-overlay:not(.intro-leaving) {
        visibility: hidden;
    }

    #intro-overlay.intro-leaving {
        pointer-events: none;
    }

    /* Prolíná se jen pozadí (fotka + gradient), ne celý overlay —
       letící logo tak může zůstat viditelné i po crossfadu */
    .intro-bg {
        transition: opacity 1.2s ease-in-out;
    }

    #intro-overlay.intro-leaving .intro-bg {
        opacity: 0;
    }

    .intro-logo {
        transition:
            transform 1.2s ease-in-out,
            opacity 1.2s ease-in-out;
    }

    /* Odlétající logo nemizí, jen lehce zprůhlední a „usadí se" na panelu */
    #intro-overlay.intro-leaving .intro-logo {
        opacity: 0.8;
    }

    /* Text mizí rychleji než zbytek overlaye (1.2s crossfade);
       při návratu do intra se naopak objeví až ke konci prolnutí */
    .intro-enter {
        transition:
            opacity 0.4s ease-in-out 0.8s,
            color 0.3s ease-in-out;
    }

    #intro-overlay.intro-leaving .intro-enter {
        opacity: 0;
        transition:
            opacity 0.4s ease-in-out,
            color 0.3s ease-in-out;
    }
</style>

<script>
    let cleanup: (() => void) | undefined;

    function setupIntro() {
        cleanup?.();
        cleanup = undefined;

        const introOverlay = document.getElementById("intro-overlay");
        if (!introOverlay) return; // podstránky intro nemají

        const logoWrap = introOverlay.querySelector<HTMLElement>(".intro-logo");
        const headerPanel = document.getElementById("main-header");
        let animating = false;
        let revealRun = 0;

        // Transform, který posadí intročkové logo přesně na logo v Headeru.
        // headerAtFinal: header už stojí na finální pozici (návrat z hl. strany),
        // jinak je ještě vysunutý o svou šířku vlevo (vstup).
        const flightTransform = (headerAtFinal: boolean): string => {
            const introLogo = logoWrap?.querySelector("img");
            const headerLogo = headerPanel?.querySelector("img");
            if (!logoWrap || !introLogo || !headerPanel || !headerLogo)
                return "";

            // Přirozenou pozici loga měříme bez případného transformu,
            // aby přepočet fungoval i po resize okna
            const prevTransition = logoWrap.style.transition;
            const prevTransform = logoWrap.style.transform;
            logoWrap.style.transition = "none";
            logoWrap.style.transform = "none";
            const from = introLogo.getBoundingClientRect();
            logoWrap.style.transform = prevTransform;
            void logoWrap.offsetHeight;
            logoWrap.style.transition = prevTransition;

            const to = headerLogo.getBoundingClientRect();
            const panelOffset = headerAtFinal
                ? 0
                : headerPanel.getBoundingClientRect().width;
            const dx =
                to.left +
                panelOffset +
                to.width / 2 -
                (from.left + from.width / 2);
            const dy = to.top + to.height / 2 - (from.top + from.height / 2);
            const scale = to.width / from.width;
            return `translate(${dx}px, ${dy}px) scale(${scale})`;
        };

        // Třída header-revealing platí jen po dobu náběhu obsahu — panel menu
        // podle ní na tu chvíli vypíná scroll (viz Header.astro). Musí se volat
        // až po jejím nasazení, jinak getAnimations() reveal ještě nevidí.
        // Prázdné pole (prefers-reduced-motion) je v pořádku: promise se splní
        // hned a třída padne, takže panel nezůstane bez scrollu. Prvky přitom
        // nikam neskočí — animace končí na hodnotách, které mají i bez ní.
        const endRevealWhenDone = () => {
            if (!headerPanel) return;
            const run = ++revealRun;
            const running = headerPanel.getAnimations({ subtree: true });
            void Promise.allSettled(running.map((a) => a.finished)).then(() => {
                // Mezitím mohl proběhnout návrat do Intra a další vstup —
                // ten si svůj náběh dohlídá sám
                if (run === revealRun)
                    headerPanel.classList.remove("header-revealing");
            });
        };

        const enterMain = () => {
            if (animating || introOverlay.classList.contains("intro-leaving"))
                return;
            animating = true;
            sessionStorage.setItem("intro-seen", "1");
            document.removeEventListener("keydown", onKeydown);

            if (logoWrap) logoWrap.style.transform = flightTransform(false);
            // header-revealing jen tady: postupný náběh obsahu patří k příchodu
            // z Intra, ne k refreshi ani návratu z podstránky (viz Header.astro)
            headerPanel?.classList.add("header-entered", "header-revealing");
            introOverlay.classList.add("intro-leaving");
            endRevealWhenDone();
        };

        const backToIntro = () => {
            if (animating || !introOverlay.classList.contains("intro-leaving"))
                return;
            animating = true;

            if (logoWrap) {
                // Po refreshi v menu je intro logo schované (viz skipIntro) —
                // vrať mu viditelnost, ať může odletět zpátky.
                logoWrap.style.opacity = "";
                // Posaď logo bez animace na aktuální pozici headerového
                // (uložený transform může být po resize zastaralý)…
                logoWrap.style.transition = "none";
                logoWrap.style.transform = flightTransform(true);
                void logoWrap.offsetHeight;
                logoWrap.style.transition = "";
                // …a nech ho odletět zpátky doprostřed
                logoWrap.style.transform = "";
            }
            // Sundáním třídy se animace zahodí (prvky zůstanou viditelné,
            // panel stejně odjíždí) — a při dalším vstupu se nasadí znovu
            // od nuly, takže položky zase naběhnou postupně
            headerPanel?.classList.remove("header-entered", "header-revealing");
            introOverlay.classList.remove("intro-leaving");
        };

        // Mezerník/Enter na dokumentu — preventDefault zabrání scrollu
        // i syntetickému kliku na fokusované tlačítko (dvojí spuštění)
        const onKeydown = (e: KeyboardEvent) => {
            if (e.key === " " || e.key === "Enter") {
                e.preventDefault();
                enterMain();
            }
        };

        // Uživatel intrem už prošel — přeskoč rovnou do usazeného stavu
        // (vše bez animací: přechody se na okamžik vypnou a stav se
        // commitne vynuceným reflow)
        const skipIntro = () => {
            const animated = [
                headerPanel,
                document.getElementById("header-logo-btn"),
                document.getElementById("header-logo"),
                logoWrap,
                ...introOverlay.querySelectorAll<HTMLElement>(
                    ".intro-bg, .intro-enter",
                ),
            ];
            for (const el of animated) if (el) el.style.transition = "none";

            // Refresh za intrem: žádný vlet, žádné lepení. Intro logo se
            // dřív „přilepovalo" na header přes flightTransform, jenže na
            // téhle cestě se počítá hned při načtení, kdy layout ještě není
            // hotový → logo dosedlo vedle a bylo vidět dvakrát. Teď ho jen
            // schováme a necháme viditelné čistě header logo.
            headerPanel?.classList.add("header-entered");
            if (logoWrap) logoWrap.style.opacity = "0";
            introOverlay.classList.add("intro-leaving");
            void introOverlay.offsetHeight;

            for (const el of animated) if (el) el.style.transition = "";

            // Stav je usazený — pomocnou třídu sundej, aby CSS pojistka
            // proti probliku neschovávala overlay po návratu do intra
            document.documentElement.classList.remove("intro-seen");
        };

        // Konec crossfadu (kterýmkoli směrem) poznáme podle opacity
        // pozadí — overlay sám už se neprolíná
        introOverlay.addEventListener("transitionend", (e) => {
            if (
                e.target instanceof Element &&
                e.target.classList.contains("intro-bg") &&
                e.propertyName === "opacity"
            ) {
                animating = false;
            }
        });

        introOverlay.addEventListener("click", enterMain);
        document
            .getElementById("header-logo-btn")
            ?.addEventListener("click", backToIntro);

        // Po resize okna se posune header i jeho logo — usazené intro
        // logo drží svou starou (px) pozici, takže by se od headerového
        // odtrhlo a vypadalo jako druhé, duplicitní logo. Přilepíme ho
        // zpátky bez animace.
        const onResize = () => {
            if (!logoWrap || !introOverlay.classList.contains("intro-leaving"))
                return;
            const prevTransition = logoWrap.style.transition;
            logoWrap.style.transition = "none";
            logoWrap.style.transform = flightTransform(true);
            void logoWrap.offsetHeight;
            logoWrap.style.transition = prevTransition;
        };
        window.addEventListener("resize", onResize);

        if (sessionStorage.getItem("intro-seen")) {
            skipIntro();
        } else {
            document.addEventListener("keydown", onKeydown);
        }

        cleanup = () => {
            window.removeEventListener("resize", onResize);
            document.removeEventListener("keydown", onKeydown);
        };
    }

    // Spusť znovu po každé Astro navigaci
    document.addEventListener("astro:page-load", setupIntro);

    // Klientská navigace nejde přes blokující skript v <head> — třídu proti
    // probliku nasaď znovu. Musí to být až v after-swap: Astro při swapu
    // (swapRootAttributes) smaže všechny atributy <html>, takže cokoli
    // nasazeného v before-swap by se zahodilo přesně v momentě, kdy se do DOM
    // dostane intro overlay. After-swap ještě běží uvnitř update callbacku
    // view transition, tedy před snímkem nové stránky.
    document.addEventListener("astro:after-swap", () => {
        if (sessionStorage.getItem("intro-seen")) {
            document.documentElement.classList.add("intro-seen");
        }
    });
</script>
