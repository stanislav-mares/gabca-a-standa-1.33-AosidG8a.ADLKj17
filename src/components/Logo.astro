---
import { Image } from "astro:assets";
import mainLogo from "../assets/logo-new.webp";

// 1. (Optional) Define the TypeScript interface for your props
interface Props {
    width: number;
    height: number; // The '?' makes this prop optional
    maxHeight?: string; // CSS délka; logo je čtvercové, takže limituje i šířku
}

// 2. Destructure the properties from Astro.props
const { width = 128, height = 128, maxHeight } = Astro.props;

const size = maxHeight
    ? `min(${width}px, 60vw, ${maxHeight})`
    : `min(${width}px, 60vw)`;
---

<div class="flex justify-center">
    <Image
        src={mainLogo}
        alt="Logo"
        width={width}
        height={height}
        class="max-w-full h-auto"
        style={`width: ${size}`}
    />
</div>
