---
import { Image } from "astro:assets";
import mainLogo from "../assets/logo-bez-pozadi.png";

// 1. (Optional) Define the TypeScript interface for your props
interface Props {
    width: number;
    height: number; // The '?' makes this prop optional
    maxHeight?: string; // CSS délka; logo je čtvercové, takže limituje i šířku
    maxWidth?: string; // podíl šířky viewportu, který logo nesmí přesáhnout
    /** Hotový CSS rozměr; přebije dopočet z width/maxWidth/maxHeight.
     *  Umožňuje držet velikost v proměnné a odkazovat se na ni i odjinud. */
    size?: string;
}

// 2. Destructure the properties from Astro.props
const {
    width = 128,
    height = 128,
    maxHeight,
    maxWidth = "60vw",
    size: sizeOverride,
} = Astro.props;

const limits = [`${width}px`, maxWidth, maxHeight].filter(Boolean);
const size = sizeOverride ?? `min(${limits.join(", ")})`;
---

<div class="flex justify-center">
    <Image
        src={mainLogo}
        alt="Logo"
        width={width}
        height={height}
        class="max-w-full h-auto"
        style={`width: ${size}`}
    />
</div>
