---
const base = import.meta.env.BASE_URL;

interface NavLink {
    href: string;
    label: string;
}

const links: NavLink[] = [
    { href: `${base}uvodni-informace`, label: "Úvodní informace" },
    { href: `${base}svatebni-den`, label: "Svatební den" },
    { href: `${base}ubytovani`, label: "Ubytování" },
    { href: `${base}nas-pribeh`, label: "Náš příběh" },
    { href: `${base}fotogalerie`, label: "Fotogalerie" },
    { href: `${base}dotaznik`, label: "Dotazník" },
];

// Čárky mají pevný box (w-10) a krátí se přes scaleX, ne přes width —
// šířka by přeskládala řádek a vnější konec by ujel dovnitř. Origin na
// vnějším konci drží ten konec na místě a ubírá se jen zevnitř ven.
//
// Plynulost: na elementu smí běžet jen transform (+ will-change), aby ho
// prohlížeč nechal na vlastní vrstvě. Barva se proto nepřebarvuje, ale
// prolíná přes ::before — opacity i transform zvládne kompozitor, takže
// se 1px linka nerasterizuje každý snímek znovu a hrana neposkakuje.
const ruleBase =
    "relative h-px w-10 shrink-0 bg-muted/30 transition-transform duration-300 will-change-transform group-hover:scale-x-75 before:absolute before:inset-0 before:bg-accent/60 before:opacity-0 before:transition-opacity before:duration-300 group-hover:before:opacity-100";
---

<nav class="menu-nav w-max max-w-full px-6">
    <ul>
        {
            links.map(({ href, label }) => (
                <li class="group">
                    <a
                        href={href}
                        class="flex items-center justify-center gap-2 py-2 md:py-3 text-muted transition-colors duration-300 group-hover:text-ink"
                    >
                        <span class={`${ruleBase} origin-left`} />
                        {/* scale místo letter-spacingu: Parisienne je psací
                            písmo, prostrkání by rozpojilo tahy mezi znaky.
                            Písmo je v CSS rovnou v té větší (hoverované)
                            velikosti a v klidu se zmenšuje — rastr je pak
                            ostrý ve zvětšeném stavu, kam se uživatel dívá,
                            a zmenšení oko nepozná. */}
                        <span class="font-heading text-[clamp(1.7rem,5.46vmin,3.05rem)] leading-snug whitespace-nowrap origin-center transform-gpu scale-[0.952] transition-transform duration-300 will-change-transform group-hover:scale-100">
                            {label}
                        </span>
                        <span class={`${ruleBase} origin-right`} />
                    </a>
                </li>
            ))
        }
    </ul>
</nav>
