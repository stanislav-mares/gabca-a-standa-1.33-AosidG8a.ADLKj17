
---
import GrainIcon from "./GrainIcon.astro";

const base = import.meta.env.BASE_URL;

interface NavLink {
    href: string;
    label: string;
}

const links: NavLink[] = [
    { href: `${base}svatebni-den`, label: "Svatební den" },
    { href: `${base}ubytovani`, label: "Ubytování" },
    { href: `${base}nas-pribeh`, label: "Náš příběh" },
    { href: `${base}fotogalerie`, label: "Fotogalerie" },
    { href: `${base}dotaznik`, label: "Dotazník" },
];
---

<nav class="menu-nav w-max max-w-full">

    <ul>
        {/* Delay se počítá od kliknutí na „Vstoupit" (Header pauzuje reveal,
            dokud panel nevjede): položky navazují na dosednutí letícího loga
            (1.2s) a hned za ním jdoucí podnadpis. */}
        {
            links.map(({ href, label }, i) => (
                <li
                    class="group"
                    data-reveal
                    style={`--reveal-delay: ${1.45 + i * 0.08}s`}
                >
                    <a
                        href={href}
                        class="flex items-start justify-center py-[calc(var(--spacing-tight)/2)] text-muted transition-colors duration-300 group-hover:text-ink"
                    >
                        {/* scale místo letter-spacingu: Parisienne je psací
                            písmo, prostrkání by rozpojilo tahy mezi znaky.
                            Písmo je v CSS rovnou v té větší (hoverované)
                            velikosti a v klidu se zmenšuje — rastr je pak
                            ostrý ve zvětšeném stavu, kam se uživatel dívá,
                            a zmenšení oko nepozná. */}
                        {/* Součet vw a vh, ne vmin ani min(): u obou vždycky
                            rozhoduje jen jedna veličina a ta druhá je úplně
                            ignorovaná, takže vzniklo pásmo, kde tažení za okraj
                            okna nedělalo nic. Aditivní tvar drží obě živé. */}
                        {/* Strop je sám fluidní: od FHD nahoru drží text
                            konstantních 1.875 % šířky okna, takže proporce sedí
                            stejně na FHD, 2K i 4K a na velkém monitoru nezůstane
                            drobný. Nad 4K se růst zastaví. */}
                        <span class="font-heading text-[clamp(1.6rem,0.5rem+1.15vw+1.65vh,clamp(2.25rem,1.875vw,4.5rem))] leading-snug whitespace-nowrap origin-center transform-gpu scale-[0.952] transition-transform duration-300 will-change-transform group-hover:scale-100">
                            {label}
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
</nav>
