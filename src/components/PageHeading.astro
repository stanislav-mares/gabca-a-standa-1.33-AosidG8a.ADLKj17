---
interface Props {
    text: string;
    class?: string;
}

const { text, class: className = "" } = Astro.props;

const rule = "h-px w-12 sm:w-16 shrink-0 bg-muted/30";
---

<div class:list={["flex items-center justify-center gap-5", className]} data-reveal>
    <span class={rule}></span>
    <h1 class="font-heading text-heading tracking-wider">{text}</h1>
    <span class={rule}></span>
</div>
