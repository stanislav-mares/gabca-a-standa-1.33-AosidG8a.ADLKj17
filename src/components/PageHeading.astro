---
interface Props {
    text: string;
    class?: string;
}

const { text, class: className = "" } = Astro.props;

// Ustupují čárky, ne nadpis: `whitespace-nowrap` udělá z h1 nezmenšitelnou
// položku, takže flex ubírá z čárek. Vnější konec zůstane na kraji řádku a
// čárka se krátí zevnitř ven — stejný princip jako u hoveru v Menu.astro.
const rule = "h-px w-12 sm:w-16 min-w-0 bg-muted/30";
---

<div class:list={["flex items-center justify-center gap-tight sm:gap-block w-full", className]} data-reveal>
    <span class={rule}></span>
    <h1 class="font-heading text-heading tracking-wider whitespace-nowrap">{text}</h1>
    <span class={rule}></span>
</div>
