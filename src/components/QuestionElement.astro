---
import type { Element } from "../utils/questionnaire";
import Self from "./QuestionElement.astro";

interface Props {
  /** Prvek k vyrenderování. */
  element: Element;
  /** Unikátní základ pro atributy `name`/`id` v rámci formuláře. */
  name: string;
  /**
   * Vynutí povinnost prvku bez ohledu na konfiguraci. Používá se u podotázek –
   * jakmile se follow-up zobrazí, jeho pole musí být vyplněná.
   */
  forceRequired?: boolean;
}

const { element, name, forceRequired = false } = Astro.props;

const required = forceRequired || element.required;

// Hvězdička u povinných polí; legendu k ní nese úvodní text stránky.
// `aria-hidden`, protože povinnost čtečkám sděluje atribut `required`
// na samotném vstupu — jinak by ji ohlásily dvakrát. Prázdný label
// (follow-upy) ji nedostane, aby nikde nevisela sama.
const requiredMark =
  ' <span class="text-red-600 text-xl leading-none align-middle" aria-hidden="true">*</span>';
const labelHtml =
  required && element.label ? element.label + requiredMark : element.label;

const inputClass =
  "w-full px-4 py-3 bg-transparent border border-black rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-colors";
const labelClass =
  "block text-lg font-bold text-gray-900 mb-tight";
const descriptionClass =
  "block text-sm text-gray-500 mb-block";

const roundButtonClass =
  "flex size-9 shrink-0 items-center justify-center rounded-full border border-black text-xl leading-none text-gray-900 hover:bg-hover hover:text-ink transition-colors cursor-pointer";

const isMulti = element.type === "multi-choice";
const isChoice =
  element.type === "yes-no" ||
  element.type === "single-choice" ||
  isMulti;
const options = element.options ?? [];
// Povinnost dává u nativní validace smysl jen pro skupiny přepínačů.
const choiceRequired = required && !isMulti ? true : undefined;
---

{
  (element.type === "short-text" || element.type === "email") && (
    <div>
      <label for={name} class={labelClass} set:html={labelHtml} />
      {element.description && (
        <p class={descriptionClass} set:html={element.description} />
      )}
      <input
        type={element.type === "email" ? "email" : "text"}
        id={name}
        name={name}
        class={inputClass}
        placeholder={element.placeholder ?? "Zde napište krátkou odpověď..."}
        required={required}
      />
    </div>
  )
}

{
  element.type === "name-list" && (
    <div data-name-list={name}>
      <span class={labelClass} set:html={labelHtml} />
      {element.description && (
        <p class={descriptionClass} set:html={element.description} />
      )}

      {/* Do formuláře jde jen tohle pole – jména spojená čárkou. Viditelné
          řádky schválně `name` nemají, aby je FormData ignorovala. */}
      <input type="hidden" name={name} data-name-value />

      <div data-name-rows class="flex flex-col gap-tight">
        <div data-name-row class="flex items-center gap-tight">
          <input
            type="text"
            class={inputClass}
            placeholder={element.placeholder ?? "Jan Novák"}
            required={required}
            data-name-input
          />
          <button
            type="button"
            class:list={[roundButtonClass, "hidden"]}
            data-name-remove
            aria-label="Odebrat osobu"
          >
            <span aria-hidden="true">×</span>
          </button>
        </div>
      </div>

      <button
        type="button"
        class:list={[roundButtonClass, "mt-block mx-auto"]}
        data-name-add
        aria-label="Přidat další osobu"
      >
        <span aria-hidden="true">+</span>
      </button>
    </div>
  )
}

{
  element.type === "person-checklist" && (
    <div
      data-person-list
      data-default-checked={element.defaultChecked ? "1" : "0"}
    >
      {element.label && (
        <span class={labelClass} set:html={labelHtml} />
      )}
      {element.description && (
        <p class={descriptionClass} set:html={element.description} />
      )}

      {/* Řádky dogeneruje skript ze jmen vyplněných výš; do formuláře jde
          zase jen skryté pole se jmény zaškrtnutých osob. */}
      <input type="hidden" name={name} data-person-value />
      <div data-person-rows class="flex flex-col gap-tight" />
      <p data-person-empty class="text-sm text-gray-500">
        Nejdřív prosím vyplňte jména v první otázce.
      </p>
    </div>
  )
}

{
  element.type === "textarea" && (
    <div>
      <label for={name} class={labelClass} set:html={labelHtml} />
      {element.description && (
        <p class={descriptionClass} set:html={element.description} />
      )}
      <textarea
        id={name}
        name={name}
        rows="4"
        class:list={[inputClass, "resize-y"]}
        placeholder={
          element.placeholder ?? "Prostor pro detailnější odpověď..."
        }
        required={required}
      />
    </div>
  )
}

{
  isChoice && (
    <div data-person-exclusive={element.exclusivePersons ? "" : undefined}>
      <span class={labelClass} set:html={labelHtml} />
      {element.description && (
        <p class={descriptionClass} set:html={element.description} />
      )}
      <div class="flex flex-col gap-tight">
        {options.map((opt) => (
          <div>
            <label class="flex items-center gap-tight cursor-pointer text-gray-900">
              <input
                type={isMulti ? "checkbox" : "radio"}
                id={`${name}-${opt.value}`}
                name={isMulti ? `${name}-${opt.value}` : name}
                value={opt.value}
                class="size-4 accent-accent"
                required={choiceRequired}
                data-followup={
                  opt.followUp ? `${name}-${opt.value}-followup` : undefined
                }
                data-ends-form={opt.endsForm ? "" : undefined}
              />
              <span set:html={opt.label} />
            </label>

            {opt.followUp && (
              <div
                id={`${name}-${opt.value}-followup`}
                class="follow-up hidden mt-block ml-block pl-block border-l-2 border-gray-200 flex-col gap-block"
              >
                {opt.followUp.heading && (
                  <p
                    class="text-sm font-medium text-gray-800"
                    set:html={opt.followUp.heading}
                  />
                )}
                {opt.followUp.elements.map((sub, k) => (
                  <Self
                    element={sub}
                    name={`${name}-${opt.value}-s${k}`}
                    forceRequired
                  />
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  )
}
