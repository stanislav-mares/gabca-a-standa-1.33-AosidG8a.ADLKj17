---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Image } from "astro:assets";
import mainPhoto from "../assets/dkr-1795.jpg";
---

<!doctype html>
<html lang="cs">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
        <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
        <meta name="generator" content={Astro.generator} />
        <title>S & G</title>

        <!-- Blokující skript: označ html třídou ještě před prvním paintem,
             aby po refreshi neprobliklo intro (CSS pak rovnou ukáže header) -->
        <script is:inline>
            if (sessionStorage.getItem("intro-seen")) {
                document.documentElement.classList.add("intro-seen");
            }
        </script>

        <ClientRouter />
    </head>
    <body class="text-text text overscroll-none">
        <!-- Fotka pozadí mimo <main>: neúčastní se slide přechodu a prosvítá
             skrz průhledné panely podstránek -->
        <div class="fixed flex -z-10 overflow-hidden inset-0 w-full h-full">
            <div class="flex-1">
                <Image
                    src={mainPhoto}
                    alt=""
                    widths={[768, 1280, 1920, 2799]}
                    sizes="100vw"
                    format="webp"
                    loading="eager"
                    class="w-full h-full object-cover scale-130 origin-[0%_50%]"
                />
            </div>
        </div>
        <slot />

        <script>
            // Scrollbar panelu se během slide přechodu vezl spolu se stránkou.
            // Třídu nasazujeme už v before-preparation, tedy dřív, než si view
            // transition udělá snímek odcházející stránky — scrollbar tak zmizí
            // oběma. Sundáváme ji až na `finished` (konec animace, ne konec
            // swapu DOM); `finally` ji neponechá viset u přerušeného přechodu.
            document.addEventListener("astro:before-preparation", (e) => {
                document.documentElement.classList.add("vt-running");

                // Odchod z úvodní stránky: logo a menu zhasnou dřív, než panel
                // odjede. View transition si odcházející stránku vyfotí hned na
                // začátku, takže fade musí doběhnout ještě před tím — Astro na
                // `loader` čeká, tak si do něj vložíme animaci. Podstránky
                // header nemají, tam se navigace nezdrží.
                //
                // Web Animations API místo CSS tříd záměrně: animace sedí přímo
                // na elementu, takže nezávisí na tom, který scoped stylopis má
                // Astro po swapu zrovna v hlavičce. Přes třídy to fungovalo jen
                // napoprvé a pak mizelo už jen logo. `fill: forwards` drží
                // prvky ztlumené i pro snímek přechodu.
                //
                // Položky menu hasnou v kaskádě shora dolů, ne jako jeden blok.
                // Prodloužit fade nejde zadarmo — o jeho délku se protáhne celá
                // navigace — zatímco kaskáda dá pozvolný dojem uvnitř zhruba
                // stejného rozpočtu: krátký fade jedné položky, posunuté starty.
                const fading = [
                    document.getElementById("header-logo-btn"),
                    ...document.querySelectorAll(".menu-nav li"),
                ].filter((el) => el !== null);
                if (fading.length === 0) return;

                const FADE = 90;
                const STEP = 18;

                const load = e.loader;
                e.loader = async () => {
                    const faded = Promise.all(
                        fading.map(
                            (el, i) =>
                                el.animate(
                                    { opacity: 0.3 },
                                    {
                                        duration: FADE,
                                        delay: i * STEP,
                                        // `ease-in`, ne `ease-in-out`: fade
                                        // nesmí dobrzdit do stopky těsně před
                                        // rozjezdem panelu, jinak je na švu
                                        // znát dvojí zpomalení
                                        easing: "ease-in",
                                        fill: "forwards",
                                    },
                                ).finished,
                        ),
                    );
                    // Fetch se snímkem nesouvisí, tak ať běží souběžně s fade —
                    // navigace pak stojí max(fade, síť) místo jejich součtu
                    await Promise.all([faded, load()]);
                };
            });

            // Astro při swapu (swapRootAttributes) smaže VŠECHNY atributy
            // <html> a nasadí ty z načteného dokumentu — třídu tedy musíme
            // vrátit. after-swap běží ještě uvnitř update callbacku view
            // transition, takže to stihne před snímkem nové stránky.
            document.addEventListener("astro:after-swap", () => {
                document.documentElement.classList.add("vt-running");
            });

            document.addEventListener("astro:before-swap", (e) => {
                e.viewTransition.finished.finally(() => {
                    document.documentElement.classList.remove("vt-running");
                });
            });
        </script>
    </body>
</html>
