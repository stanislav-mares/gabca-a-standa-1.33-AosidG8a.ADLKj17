---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Image } from "astro:assets";
import mainPhoto from "../assets/dkr-1795.jpg";
---

<!doctype html>
<html lang="cs">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
        <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
        <meta name="generator" content={Astro.generator} />
        <title>S & G</title>

        <!-- Blokující skript: označ html třídou ještě před prvním paintem,
             aby po refreshi neprobliklo intro (CSS pak rovnou ukáže header) -->
        <script is:inline>
            if (sessionStorage.getItem("intro-seen")) {
                document.documentElement.classList.add("intro-seen");
            }
        </script>

        <ClientRouter />
    </head>
    <body class="text-text text overscroll-none">
        <!-- Fotka pozadí mimo <main>: neúčastní se slide přechodu a prosvítá
             skrz průhledné panely podstránek -->
        <div class="fixed flex -z-10 overflow-hidden inset-0 w-full h-full">
            <div class="flex-1">
                <Image
                    src={mainPhoto}
                    alt=""
                    widths={[768, 1280, 1920, 2799]}
                    sizes="100vw"
                    format="webp"
                    loading="eager"
                    class="w-full h-full object-cover scale-130 origin-[0%_50%]"
                />
            </div>
        </div>
        <slot />

        <script>
            // Scrollbar panelu se během slide přechodu vezl spolu se stránkou.
            // Třídu nasazujeme už v before-preparation, tedy dřív, než si view
            // transition udělá snímek odcházející stránky — scrollbar tak zmizí
            // oběma. Sundáváme ji až na `finished` (konec animace, ne konec
            // swapu DOM); `finally` ji neponechá viset u přerušeného přechodu.
            document.addEventListener("astro:before-preparation", () => {
                document.documentElement.classList.add("vt-running");
            });

            // Astro při swapu (swapRootAttributes) smaže VŠECHNY atributy
            // <html> a nasadí ty z načteného dokumentu — třídu tedy musíme
            // vrátit. after-swap běží ještě uvnitř update callbacku view
            // transition, takže to stihne před snímkem nové stránky.
            document.addEventListener("astro:after-swap", () => {
                document.documentElement.classList.add("vt-running");
            });

            document.addEventListener("astro:before-swap", (e) => {
                e.viewTransition.finished.finally(() => {
                    document.documentElement.classList.remove("vt-running");
                });
            });
        </script>
    </body>
</html>
