---
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/BackButton.astro";
import GrainIcon from "../components/GrainIcon.astro";
import PageHeading from "../components/PageHeading.astro";
import Questionnaire from "../components/Questionnaire.astro";
import type { Question } from "../utils/questionnaire";
import { slideTransition } from "../utils/transitions";

const heading = "Dotazník";
const intro =
    "Poprosíme vás o vyplnění krátkého dotazníku. Moc nám to pomůže s další organizací a přípravami na náš svatební den. Děkujeme :)";

// Vykresluje se přes `set:html`, takže smí obsahovat značky — obsah je
// statický a psaný ručně, nikdy sem nesmí vstup od uživatele.
const requiredLegend = `<span class="text-red-600 text-xl leading-none align-middle">*</span> - označuje povinná pole`;

// Ukázková konfigurace – uprav si otázky i prvky přímo tady.
const questions: Question[] = [
    {
        id: "ucast",
        heading: "",
        elements: [
            {
                type: "name-list",
                label: "Jméno",
                description:
                    "Pokud vyplňuješ za rodinu / pár, přidej tlačítkem + řádek pro každého z nich.",
                placeholder: "Standa",
                required: true,
            },
            {
                type: "email",
                label: "E-mail",
                description:
                    "Nemusíte vyplňovat, ale ulehčí nám to komunikaci s Vámi v případě např. problémů, pro následné zaslání fotek atd.",
                placeholder: "jan.novak@email.cz",
            },
        ],
    },
    {
        id: "arrival",
        heading: "",
        elements: [
            {
                type: "yes-no",
                label: "Dorazíš / dorazíte na svatbu?",
                description: "Prosíme o potvrzení účasti nejpozději do 16. 8.",
                required: true,
                options: [
                    {
                        value: "ano",
                        label: "Ano",
                    },
                    {
                        value: "ne",
                        label: "Bohužel nemohu",
                        endsForm: true,
                    },
                    {
                        value: "jine",
                        label: "Jiné",
                        followUp: {
                            elements: [
                                {
                                    type: "textarea",
                                    label: "",
                                    placeholder: "Např. obřad nestihnu, ale na odpolední párty budu, teď nevím - vyjádřím se do konce srpna, aj...",
                                },
                            ],
                        },
                    },
                ],
            },
        ],
    },

    {
        id: "prijezd",
        heading: "",
        elements: [
            {
                type: "single-choice",
                label: "Kdy přijedeš?",
                required: true,
                options: [
                    {
                        value: "svatba",
                        label: "V den svatby",
                        followUp: {
                            heading: `Příjezd cca mezi 10:30 - 11:00. Více informací naleznete zde: <a href="${import.meta.env.BASE_URL}svatebni-den" class="underline text-black hover:bg-hover transition-colors">zde</a>`,
                            elements: [],
                        },
                    },
                    {
                        value: "patek",
                        label: "V pátek",
                        followUp: {
                            heading: "Pokud to máte na svatební místo daleko nebo chcete pomoct se svatebními přípravami, můžete využít příjezdu již v pátek.",
                            elements: [],
                        },
                    },
                    {
                        value: "jine",
                        label: "Jiné",
                        followUp: {
                            elements: [
                                {
                                    type: "textarea",
                                    label: "",
                                    placeholder: "Upřesnění příjezdu...",
                                },
                            ],
                        },
                    },
                ],
            },
        ],
    },

    {
        id: "sleep",
        heading: "",
        elements: [
            {
                type: "yes-no",
                label: "Budeš chtít přespat přímo na místě nebo v blízkém okolí?",
                description: `Ubytování jsme schopni zajistit pro všechny hosty. Bližší informace k ubytování jsou popsány na stránce
                <a href="${import.meta.env.BASE_URL}svatebni-den" class="underline text-black hover:bg-hover transition-colors">Svatební den</a>. Bližší informace k možnostem ubytování včetně rozdělení pokojů a přehledu ubytovaných najdete včas na stránce
                <a href="${import.meta.env.BASE_URL}ubytovani" class="underline text-black hover:bg-hover transition-colors">Ubytování</a>.`,
                required: true,
                options: [
                    {
                        value: "ano",
                        label: "Ano",
                        followUp: {
                            elements: [
                                {
                                    type: "person-checklist",
                                    label: "",
                                    description: "Koho se týká?",
                                    defaultChecked: true,
                                },
                            ],
                        },
                    },
                    {
                        value: "ne",
                        label: "Ne",
                        followUp: {
                            heading: "Pojedu vlastním autem domů.",
                            elements: [],
                        },
                    },
                    {
                        value: "jine",
                        label: "Jiné",
                        followUp: {
                            elements: [
                                {
                                    type: "textarea",
                                    label: "",
                                    placeholder: "Přivezu si např. stan, přijedu obytňákem, aj...",
                                },
                            ],
                        },
                    },
                ],
            },
        ],
    },
    {
        id: "strava",
        heading: "",
        elements: [
            {
                type: "multi-choice",
                label: "Máš / máte nějaké stravovací omezení?",
                description:
                    "Zaškrtni vše, co se tě / vás týká, a u každé možnosti vyber, koho konkrétně.",
                options: [
                    {
                        value: "vegan",
                        label: "Vegan",
                        followUp: {
                            elements: [
                                {
                                    type: "person-checklist",
                                    label: "",
                                    description: "Koho se týká?",
                                },
                            ],
                        },
                    },
                    {
                        value: "vegetarian",
                        label: "Vegetarián",
                        followUp: {
                            elements: [
                                {
                                    type: "person-checklist",
                                    label: "",
                                    description: "Koho se týká?",
                                },
                            ],
                        },
                    },
                    {
                        value: "bezlepkova",
                        label: "Bezlepková dieta",
                        followUp: {
                            elements: [
                                {
                                    type: "person-checklist",
                                    label: "",
                                    description: "Koho se týká?",
                                },
                            ],
                        },
                    },
                    {
                        value: "alergie",
                        label: "Alergie",
                        followUp: {
                            elements: [
                                {
                                    type: "short-text",
                                    label: "",
                                    placeholder: "Jaké alergie? (ořechy, laktóza, …)",
                                },
                                {
                                    type: "person-checklist",
                                    label: "",
                                    description: "Koho se týká?",
                                },
                            ],
                        },
                    },
                    {
                        value: "jine",
                        label: "Jiné",
                        followUp: {
                            elements: [
                                {
                                    type: "textarea",
                                    label: "",
                                    placeholder: "Jaké omezení?",
                                },
                                {
                                    type: "person-checklist",
                                    label: "",
                                    description: "Koho se týká?",
                                },
                            ],
                        },
                    },
                ],
            },
        ],
    },
    {
        id: "porce",
        heading: "",
        elements: [
            {
                type: "multi-choice",
                label: "Pro rodiny s dětmi prosíme o uvedení, zda požadujete na oběd dětskou porci?",
                description:
                    "Dospělá porce je předvyplněná pro všechny. Pro batole nechat obě možnosti prázdné.",
                exclusivePersons: true,
                options: [
                    {
                        value: "dospele",
                        label: "Dospělé",
                        followUp: {
                            elements: [
                                {
                                    type: "person-checklist",
                                    label: "",
                                    description: "Koho se týká?",
                                    defaultChecked: true,
                                },
                            ],
                        },
                    },
                    {
                        value: "detske",
                        label: "Dětské",
                        followUp: {
                            elements: [
                                {
                                    type: "person-checklist",
                                    label: "",
                                    description: "Koho se týká?",
                                },
                            ],
                        },
                    },
                ],
            },
        ],
    },
    {
        id: "piti-nealko",
        heading: "",
        elements: [
            {
                type: "multi-choice",
                label: "Co by sis dal / dali během svatebního dne k pití: nealko?",
                options: [
                    { value: "perliva-voda", label: "Perlivá voda" },
                    { value: "voda-citron", label: "Voda s citrónem" },
                    { value: "dzus", label: "Džus" },
                    { value: "kofola", label: "Kofola" },
                    { value: "coca-cola", label: "Coca-Cola" },
                    { value: "tonic", label: "Tonic" },
                    {
                        value: "birell",
                        label: "Birell",
                        followUp: {
                            elements: [
                                {
                                    type: "single-choice",
                                    label: "",
                                    options: [
                                        { value: "ochuceny", label: "Ochucený" },
                                        {
                                            value: "neochuceny",
                                            label: "Neochucený",
                                        },
                                    ],
                                },
                            ],
                        },
                    },
                    { value: "limonada", label: "Domácí limonáda" },
                    {
                        value: "jine",
                        label: "Jiné",
                        followUp: {
                            elements: [
                                {
                                    type: "short-text",
                                    label: "",
                                    placeholder: "Co jiného?",
                                },
                            ],
                        },
                    },
                ],
            },
        ],
    },
    {
        id: "piti-alko",
        heading: "",
        elements: [
            {
                type: "multi-choice",
                label: "Co by sis dal / dali během svatebního dne k pití: alko?",
                options: [
                    { value: "pivo", label: "Pivo" },
                    { value: "vino", label: "Víno" },
                    { value: "sampus", label: "Šampus" },
                    { value: "gin-tonic", label: "Gin-tonic" },
                    { value: "aperol", label: "Aperol" },
                    { value: "rum-cola", label: "Rum s colou" },
                    {
                        value: "jine",
                        label: "Jiné",
                        followUp: {
                            elements: [
                                {
                                    type: "short-text",
                                    label: "",
                                    placeholder: "Co jiného?",
                                },
                            ],
                        },
                    },
                ],
            },
        ],
    },
    {
        id: "piti-alko-plus",
        heading: "",
        elements: [
            {
                type: "multi-choice",
                label: "Co by sis dal / dali během svatebního dne k pití: alko+?",
                options: [
                    { value: "slivovice", label: "Slivovice" },
                    { value: "mandlovice", label: "Mandlovice" },
                    { value: "rum", label: "Rum" },
                    { value: "whiskey", label: "Whiskey" },
                    { value: "becherovka", label: "Becherovka" },
                    { value: "jagermeister", label: "Jägermeister" },
                    {
                        value: "jine",
                        label: "Jiné",
                        followUp: {
                            elements: [
                                {
                                    type: "short-text",
                                    label: "",
                                    placeholder: "Co jiného?",
                                },
                            ],
                        },
                    },
                ],
            },
        ],
    },
    {
        id: "poznamka",
        heading: "",
        elements: [
            {
                type: "textarea",
                label: "Napadá tě ještě něco dalšího?",
                placeholder: "...",
            },
        ],
    },
];
---

<Layout>
    <main
        class="h-dvh w-full pt-top bg-surface overflow-y-auto"
        transition:animate={slideTransition}
        transition:name="main-panel"
    >
        <section class="flex flex-col items-center px-gutter">
            <PageHeading text={heading} />
            <div class="w-full max-w-3xl pt-heading">
                <div data-reveal style="--reveal-offset: 0s">
                    <p class="paragraph">{intro}</p>
                    <p class="paragraph mt-block" set:html={requiredLegend} />
                </div>
                <div class="pt-section pb-[50vh]" data-reveal style="--reveal-offset: 0.08s">
                    <Questionnaire questions={questions} showAll />
                    <GrainIcon />
                </div>
            </div>
        </section>

        <BackButton />
    </main>
</Layout>
