---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/BackButton.astro";
import GrainIcon from "../components/GrainIcon.astro";
import PageHeading from "../components/PageHeading.astro";
import { slideTransition } from "../utils/transitions";
import { getGalleryPhotosWithLightbox } from "../utils/gallery";

const heading = "Fotogalerie";
const photos = await getGalleryPhotosWithLightbox();
---

<Layout>
    <main
        class="h-dvh w-full pt-top bg-surface overflow-y-auto"
        transition:animate={slideTransition}
        transition:name="main-panel"
    >
        <section class="flex flex-col items-center justify-center px-gutter md:px-40 pb-[50vh]">
            <PageHeading text={heading} />
            {/* Mozaika: tvar buňky sleduje orientaci fotky — portrét stojí
                v jednom sloupci (3:4), landscape leží přes dva (3:2). Poměr
                držíme přes `aspect-*`, ne přes pevnou výšku řádku, aby tvar
                buňky nezávisel na šířce okna. Řádky se pak dorovnávají na
                stejnou výšku (výchozí `items-stretch`), takže mřížka nemá
                díry — daní je mírný ořez, protože buňka nesedne na poměr
                fotky přesně. */}
            <div
                id="galerie"
                class="pt-heading grid grid-cols-2 md:grid-cols-4 2xl:grid-cols-6 grid-flow-dense gap-tight 2xl:w-3/4"
            >
                {
                    photos.map((photo, index) => {
                        const landscape = photo.image.width > photo.image.height;
                        // Fallback `src` u <Image> jinak vyjde z rozměrů zdroje,
                        // takže by ke každé fotce přibyla varianta v plném
                        // rozlišení. Prohlížeč si stejně vybírá ze `srcset` —
                        // stačí největší šířka, kterou tam nabízíme.
                        const fallbackWidth = landscape ? 1600 : 800;
                        const fallbackHeight = Math.round(
                            (photo.image.height / photo.image.width) * fallbackWidth,
                        );
                        return (
                            <a
                                href={photo.lightbox.src}
                                data-pswp-width={photo.lightbox.width}
                                data-pswp-height={photo.lightbox.height}
                                data-cropped="true"
                                target="_blank"
                                rel="noreferrer"
                                class:list={[
                                    "block overflow-hidden rounded-lg",
                                    landscape ? "col-span-2 aspect-[3/2]" : "aspect-[3/4]",
                                ]}
                                data-reveal
                                style={`--reveal-delay: ${Math.min(0.7 + index * 0.06, 1.2)}s`}
                            >
                                <Image
                                    src={photo.image}
                                    alt=""
                                    width={fallbackWidth}
                                    height={fallbackHeight}
                                    widths={landscape ? [800, 1600] : [400, 800]}
                                    sizes={
                                        landscape
                                            ? "(min-width: 1536px) 25vw, (min-width: 768px) 50vw, 100vw"
                                            : "(min-width: 1536px) 13vw, (min-width: 768px) 25vw, 50vw"
                                    }
                                    class="h-full w-full object-cover opacity-90 transition-opacity duration-300 hover:opacity-100"
                                    loading="lazy"
                                />
                            </a>
                        );
                    })
                }
            </div>
            <GrainIcon />
        </section>

        <BackButton />
    </main>
</Layout>

<script>
    import PhotoSwipeLightbox from "photoswipe/lightbox";
    import "photoswipe/style.css";

    let lightbox: PhotoSwipeLightbox | undefined;

    // Modulový skript přežívá View Transitions, proto init/destroy přes eventy
    document.addEventListener("astro:page-load", () => {
        if (!document.getElementById("galerie")) return;
        lightbox = new PhotoSwipeLightbox({
            gallery: "#galerie",
            children: "a",
            pswpModule: () => import("photoswipe"),
        });
        lightbox.init();
    });

    document.addEventListener("astro:before-swap", () => {
        lightbox?.destroy();
        lightbox = undefined;
    });
</script>
