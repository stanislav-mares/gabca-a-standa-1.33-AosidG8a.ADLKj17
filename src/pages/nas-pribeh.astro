---
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/BackButton.astro";
import GrainIcon from "../components/GrainIcon.astro";
import PageHeading from "../components/PageHeading.astro";
import { slideTransition } from "../utils/transitions";

const heading = "Náš příběh";

interface StorySection {
    /** Kotva sekce – bez mezer, aby šla použít v URL. */
    id: string;
    year: string;
    paragraphs: string[];
}

const textContent: StorySection[] = [
    {
        id: "2014",
        year: "2014",
        paragraphs: [
            `Náš příběh začíná před 12 lety… I když jsme to od sebe měli, co by kamenem dohodil, skoro
            jsme nevěděli, že ten druhý vůbec existuje. Až volejbalový kurt zařídil, že jsme se setkali
            na jednom místě. I když už si nikdo moc nepamatuje, jak se tam vlastně Gabča ocitla,
            najednou zkrátka stála na hřišti. Do volejbalové party zapadla takřka okamžitě a stali jsme
            se dobrými přáteli.`,
            `Až po nějakém čase, na táboráku v Horní Čermné, Standa s Gabčou v průběhu večera zjistili,
            že by mezi nimi mohlo být i něco více. Za několik dalších měsíců se společně domluvili, že
            to tedy spolu zkusí. Ale bylo to váhavé rozhodnutí, jelikož v tu dobu každý studoval na
            opačném konci republiky. Jisté nebylo nic.`,
        ],
    },

    {
        id: "2015-2017",
        year: "2015 – 2017",
        paragraphs: [
            `První roky byly hlavně v duchu studia a poznávání se navzájem. Času spolu jsme neměli tolik
            a tak jsme dost komunikovali pouze přes telefon. Nicméně jak už to v začátcích bývá, měli
            jsme nové růžové brýle a to nám pomáhalo to odloučení trochu vyvažovat. Osobně jsme se
            vídali většinou jen o víkendu. Chodili jsme na procházky, zábavy, plesy a taky jezdili na
            výlety – třeba na Moravu.`,
            `Jednou dostal Standa skvělý nápad, že navštíví Gabču na kolejích v Brně. Zdálo se to jako
            parádní plán – projít se po Brně, dát si dobrou večeři a druhý den jet společně domu. Druhý
            den jsme se ale ocitli v kanceláři ředitelky a Gabče hrozilo vyloučení z kolejí. Co se
            stalo, ptáte se? Standa byl označen za ilegálního nocležníka, který pobývá na kolejích již
            několik měsíců. Důkaz byl jasný – jeden kartáček v koupelně navíc :D… Nakonec se vše
            vysvětlilo a dobře to dopadlo.`,
            `Ještě ten rok Standa daroval Gabče k Vánocům krátkou báseň. To ještě netušil, že se z toho
            stane tradice na další desetiletí.`,
        ],
    },

    {
        id: "2017-2018",
        year: "2017 – 2018",
        paragraphs: [
            `V tomto roce Gabča ukončila bakalářské studium. Standa udělal velký krok a vzal ji na
            společnou dovolenou na kolách s kamarády. Na kemp Jitřenka a zážitky nikdy nezapomeneme.`,
            `Po vztahu na dálku uzrál čas zkusit si společné bydlení. Standa ukončil studium v Liberci
            a svolil k přestěhování za Gabčou do Brna. Napsali na první inzerát, který splňoval
            podmínky, zašli na prohlídku, podepsali smlouvu a v září se stěhovali. Měli jsme velké
            štěstí, že narazili na moc fajn pronajímatele, u kterých jsme bydleli v rodinném domě.`,
            `Další rok Standa úspěšně odpromoval a našel si práci v místě. Čas utekl jako voda a byly
            Vánoce. Standa dostal od Gabči poukaz na první společnou zimní dovolenou v Krkonoších. Jupí.
            Tvrdil totiž, že umí lyžovat, tak se Gabča chtěla přesvědčit :))`,
        ],
    },

    {
        id: "2019",
        year: "2019",
        paragraphs: [
            `Standa se rozjíždí ze sjezdovky téměř „šusem", chce se ukázat. Jeho krasojízda trvá asi tak
            osm vteřin než končí v závěji. Dlouho jsme se tak nenasmáli. Další jízdy byly už ale lepší,
            tak si alespoň trochu spravil reputaci. Dovolená to byla moc fajn a oba si ji užili…`,
            `Po dlouhém zvažování Gabča rozhodla přihlásit se Erasmus (studijní pobyt) v zahraničí.
            Zanedlouho dostala vyjádření a s napětím očekávala, co se skrývá uvnitř obálky. „Byla jste
            přijata ke studiu ve Finsku – město Rovaniemi." Oba jsme měli velikou radost, ale zároveň
            jsme se báli, jak nám další odloučení prověří vztah.`,
            `Gabča vzala situaci zodpovědně a Standovi k jeho narozeninám dala kuchařku „Sám doma
            a hladový", aby mohl rozšířit své kuchařské umění a přečkal kruté časy. Bohužel knihu sice
            otevřel, ale nic z ní neuvařil, pouze párek na obalu knihy, který už ale k receptům
            nepatřil :D.`,
            `Ještě než Gabča odjela, stihli také první společnou letní dovolenou v Bulharsku, kterou si
            moc užili… V prosinci se Gabča vrátila a Standa na ní již čekal u brány na letišti
            s květinami a cedulkou, aby věděla, ke komu se hlásit, kdyby ho náhodou nepoznala.`,
        ],
    },
];
---

<Layout>
    <main
        class="h-dvh w-full pt-top bg-surface overflow-y-auto"
        transition:animate={slideTransition}
        transition:name="main-panel"
    >
        <section class="flex flex-col items-center justify-center px-gutter">
            <PageHeading text={heading} />
            <article class="flex flex-col gap-section w-full pt-heading pb-[50vh]">
                {
                    textContent.map((item, i) => (
                        <div
                            id={item.year}
                            data-story-section
                            class="scroll-mt-top w-full max-w-3xl mx-auto 2xl:max-w-none 2xl:grid 2xl:grid-cols-[1fr_minmax(0,48rem)_1fr] 2xl:gap-x-section"
                            data-reveal
                            style={`--reveal-delay: ${0.7 + i * 0.12}s`}
                        >
                            <h2
                                class:list={[
                                    "story-year font-heading text-4xl md:text-6xl 2xl:text-8xl mb-block 2xl:mb-0",
                                    "text-text opacity-25 transition-opacity duration-500",
                                    "2xl:row-start-1 2xl:self-center",
                                    i % 2 === 0
                                        ? "2xl:col-start-1 2xl:text-right"
                                        : "2xl:col-start-3 2xl:text-left",
                                ]}
                            >
                                {item.year}
                            </h2>
                            <p class="paragraph 2xl:col-start-2 2xl:row-start-1">
                                {item.content}
                            </p>
                        </div>
                    ))
                }
                {/* Odstup nahoru dodává `gap-section` článku, proto jen `mb-` */}
                <GrainIcon class="mb-section" />
            </article>
        </section>

        <BackButton />
    </main>
</Layout>

<script>
    let cleanup: (() => void) | undefined;

    function initStoryYears() {
        cleanup?.();
        cleanup = undefined;

        const main = document.querySelector("main");
        const sections = Array.from(
            document.querySelectorAll<HTMLElement>("[data-story-section]"),
        );
        if (!main || sections.length === 0) return;

        const setActive = (active: HTMLElement) => {
            for (const section of sections) {
                // Přepínáme průhlednost, ne barvu: ta je v třídách responzivní
                // (text-text na mobilu, text-ink od md) a barevný toggle by ji přebil.
                const year = section.querySelector(".story-year");
                year?.classList.toggle("opacity-100", section === active);
                year?.classList.toggle("opacity-25", section !== active);
            }
        };

        // Rok sekce se rozsvítí, jakmile se její horní hrana dotkne
        // poloviny obrazovky; do té doby svítí rok předchozí sekce.
        let ticking = false;
        const update = () => {
            ticking = false;
            const line = window.innerHeight / 2;
            let active = sections[0];
            for (let i = 1; i < sections.length; i++) {
                if (sections[i].getBoundingClientRect().top <= line)
                    active = sections[i];
            }
            setActive(active);
        };
        const onScroll = () => {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        };

        main.addEventListener("scroll", onScroll, { passive: true });
        update();
        cleanup = () => main.removeEventListener("scroll", onScroll);
    }

    document.addEventListener("astro:page-load", initStoryYears);
</script>
