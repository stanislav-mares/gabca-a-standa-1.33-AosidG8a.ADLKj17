---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/BackButton.astro";
import GrainIcon from "../components/GrainIcon.astro";
import PageHeading from "../components/PageHeading.astro";
import { slideTransition } from "../utils/transitions";
import { getLightboxSource, type LightboxSource } from "../utils/lightbox";
import parkovisteMapa from "../assets/parkoviste-farni-dvur.png";
import paleta from "../assets/barevna-paleta-cut.jpg";

const base = import.meta.env.BASE_URL;
const heading = "Svatební den";

const VENUE = "Farní dvůr, Uhřínov 1, 517 91 Liberk";
const venueQuery = encodeURIComponent(VENUE);
// `output=embed` nepotřebuje API klíč a zvládne adresu místo souřadnic
const mapEmbedUrl = `https://maps.google.com/maps?q=${venueQuery}&hl=cs&z=14&output=embed`;
// POI Farního dvora na mapy.cz — stejné `firm` id, jaké mají obě trasy jako cíl
const venueMapUrl = "https://mapy.com/cs/zakladni?source=firm&id=13923489";

/** Doporučené příjezdové trasy — sdílecí odkazy z „Vložit na web" na mapy.com. */
interface Route {
    label: string;
    embedUrl: string;
}

const routes: Route[] = [
    { label: "Trasa A - doporučujeme", embedUrl: "https://mapy.com/s/nugojebaro" },
    { label: "Trasa B", embedUrl: "https://mapy.com/s/jerefahuco" },
];

/** Svatební paleta — shodná s `.colors` v global.css. */
const palette = ["#f7d596", "#e4baa4", "#f5e2c1", "#faeddc", "#734d29"];

const linkClass =
    "underline decoration-accent underline-offset-4 hover:bg-hover transition-colors";

/**
 * Sekce stránky. `paragraphs` se renderují přes `set:html`, takže smějí
 * obsahovat značky — obsah je statický a psaný ručně, nikdy sem nesmí
 * vstup od uživatele.
 */
interface Section {
    heading?: string;
    paragraphs?: string[];
    /** Vloží mapu místa konání. */
    map?: boolean;
    /** Vloží mapy doporučených příjezdových tras. */
    routes?: boolean;
    /** Vloží vzorky svatebních barev. */
    palette?: boolean;
    /** Statický obrázek pod odstavci (např. plánek parkování), zvětšitelný. */
    image?: { src: ImageMetadata; alt: string; lightbox: LightboxSource };
}

const sections: Section[] = [
    {
        paragraphs: [
            `Řekneme si "ANO" dne 26.9.2026 na Farním dvoře Uhřínov 1, 517 91 Liberk`,
            "Vše proběhne na jednom místě — obřad, hostina i svatební párty.",
            "Sejdeme se na Farním dvoře mezi <strong>10:30 a 11:00</strong>.",
            "Svatební obřad proběhne ve <strong>12:00</strong>.",
            "Ve <strong>13:00</strong> už jako Marešovi společně usedneme ke svatebnímu stolu.",
        ],
    },
    {
        heading: "Dresscode",
        paragraphs: [
            "Budeme rádi, když zvolíte společenský oděv a pohodlnou obuv. Obřad se bude konat venku na travnatém paloučku",
            "Naše svatba bude laděna do přírodních barev a odstínů hnědé, máslově žluté, šampaňské a béžové.  Bílou barvu prosíme přenechte nevěstě.",
            "Pokud byste se chtěli sladit s námi, bude to krásné! Ale určitě na tom netrváme. Nejdůležitější pro nás je, abyste se cítili pohodlně a den si s námi užili!"
        ],
        palette: true,
    },
    {
        paragraphs: [
            "Pokud byste se chtěli sladit s námi, bude to krásné! Určitě na tom ale netrváme – nejdůležitější pro nás je, abyste se cítili pohodlně a den si s námi užili!",
            "Doporučujeme zvolit vhodnou obuv. Obřad proběhne venku na travnatém paloučku.",
        ],
    },
    {
        heading: "Svatební dary",
        paragraphs: [
            "Vaše přítomnost je pro nás tím největším darem.",
            "Pokud byste nás přece jen chtěli podpořit do společného života, nejvíce nám udělá radost finanční příspěvek.",
            "Na podzim nás čeká totiž další velký životní krok a to zahájení stavby rodinného domu.",
        ],
    },
    {
        heading: "Doprava",
        paragraphs: [
            `Přesná adresa místa: <a href="${venueMapUrl}" target="_blank" rel="noreferrer" class="${linkClass}">${VENUE}</a>.`,
        ],
        routes: true,
    },
    {
        heading: "Parkování",
        paragraphs: [
            "Prosím využijte k parkování louku naproti svatebnímu areálu viz mapka níže.",
        ],
        image: {
            src: parkovisteMapa,
            alt: "Plánek parkování u Farního dvora v Uhřínově",
            lightbox: await getLightboxSource(parkovisteMapa),
        },
    },
    {
        heading: "Ubytování",
        paragraphs: [
            "Ubytovací kapacita svatebního místa je omezená. S ubytováním zde proto počítáme především pro nejbližší rodinu a přátele.									",
            "Svatební místo využijeme na maximum proto některé z vás budeme prosit o dovezení karimatky/matrace :) 									",
            "Nicméně pro všechny pozvané hosty jsme schopni ubytování zajistit v blízkém okolí. Budeme proto rádi, když s námi protančíte celou noc :)									",
            "Odvoz na ubytování do blízkého okolí bude zajištěn a během svatebního dne bude prostor na odvezení aut. 									",
            "Vzhledem ke vzdálenosti nebudeme zajišťovat rozvozy domů. Proto prosím využijte možnost přespání, případně vlastní dopravu.									",
            "Z finančních důvodů bohužel nemůžeme uhradit ubytování všem. Ubytování v penzionu Továrníkova vila a v chatě Liebich poprosíme hosty, aby si uhradili. 									",
            "Na základě informací z dotazníku provedeme rozdělení ubytovacích kapacit.									",
            `Bližší informace k možnostem ubytování včetně rozdělení pokojů a přehledu ubytovaných najdete včas na této stránce <a href="${base}ubytovani" class="${linkClass}">Ubytování</a>..									`,
            "Louka naproti areálu je dostatečně prostorná i na nějaký ten stan v případě dobrého počasí (to máme samozřejmě objednáno :)  případně karavan.									",
            "Kapacitu svatebního místa se budeme snažit využít na maximum. Některé z vás požádáme o přivezení karimatky/matrace a  spacáku. 									",
            "Pokud to máte na svatební místo daleko nebo chcete pomoct se svatebními přípravami, můžete využít příjezdu již v pátek."
        ],
    },
    {
        heading: "Dotazník",
        paragraphs: [
            `Abychom mohli náš velký den naplánovat co nejlépe, poprosíme vás o vyplnění krátkého <a href="${base}dotaznik" class="${linkClass}">dotazníku</a> do <strong>9. 8. 2026</strong>.`,
        ],
    },
    {
        paragraphs: [
            "Svatební web budeme pravidelně aktualizovat. V případě, že by vám nějaké informace chyběly, ozvěte se nám.",
            "Na všechny se moc těšíme :)",
            "<strong>-- Gabča a Standa</strong>",
        ],
    },
];
---

<Layout>
    <main
        class="h-dvh w-full pt-top bg-surface overflow-y-auto"
        transition:animate={slideTransition}
        transition:name="main-panel"
    >
        <section class="flex flex-col items-center justify-center px-gutter">
            <PageHeading text={heading} />
            <article class="flex flex-col gap-section w-full max-w-3xl mx-auto pt-heading pb-[50vh]">
                {
                    sections.map((section, i) => (
                        <section
                            class="flex flex-col gap-block"
                            data-reveal
                            style={`--reveal-delay: ${Math.min(0.7 + i * 0.1, 1.4)}s`}
                        >
                            {section.heading && (
                                <h2 class="font-heading text-subheading text-accent">
                                    {section.heading}
                                </h2>
                            )}

                            {section.paragraphs?.map((paragraph) => (
                                <p class="paragraph" set:html={paragraph} />
                            ))}

                            {section.map && (
                                <div class="w-full overflow-hidden rounded-lg border border-black/10">
                                    <iframe
                                        src={mapEmbedUrl}
                                        title={`Mapa – ${VENUE}`}
                                        class="w-full aspect-[4/3] md:aspect-video"
                                        loading="lazy"
                                        referrerpolicy="no-referrer-when-downgrade"
                                    />
                                </div>
                            )}

                            {section.routes && (
                                <div class="flex flex-col gap-block">
                                    {routes.map((route) => (
                                        <div class="flex flex-col gap-tight">
                                            <h3 class="font-heading text-2xl text-accent">
                                                {route.label}
                                            </h3>
                                            <div class="w-full overflow-hidden rounded-lg border border-black/10">
                                                <iframe
                                                    src={route.embedUrl}
                                                    title={`${route.label} – trasa na ${VENUE}`}
                                                    class="w-full aspect-[4/3] md:aspect-video"
                                                    loading="lazy"
                                                    referrerpolicy="no-referrer-when-downgrade"
                                                />
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            )}

                            {section.image && (
                                <div data-lightbox>
                                    <a
                                        href={section.image.lightbox.src}
                                        data-pswp-width={section.image.lightbox.width}
                                        data-pswp-height={section.image.lightbox.height}
                                        target="_blank"
                                        rel="noreferrer"
                                        class="block w-full overflow-hidden rounded-lg border border-black/10 cursor-zoom-in"
                                    >
                                        <Image
                                            src={section.image.src}
                                            alt={section.image.alt}
                                            class="w-full"
                                        />
                                    </a>
                                </div>
                            )}

                            {section.palette && (
                            <Image
                                src={paleta}
                                alt="Barevná paleta"
                            />
                            )}
                        </section>
                    ))
                }
            </article>
        </section>
        <GrainIcon />

        <BackButton />
    </main>
</Layout>

<script>
    import PhotoSwipeLightbox from "photoswipe/lightbox";
    import "photoswipe/style.css";

    let lightbox: PhotoSwipeLightbox | undefined;

    // Modulový skript přežívá View Transitions, proto init/destroy přes eventy
    document.addEventListener("astro:page-load", () => {
        if (!document.querySelector("[data-lightbox]")) return;
        lightbox = new PhotoSwipeLightbox({
            gallery: "[data-lightbox]",
            children: "a",
            pswpModule: () => import("photoswipe"),
        });
        lightbox.init();
    });

    document.addEventListener("astro:before-swap", () => {
        lightbox?.destroy();
        lightbox = undefined;
    });
</script>
