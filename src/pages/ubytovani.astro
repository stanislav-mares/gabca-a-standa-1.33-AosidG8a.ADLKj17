        address: "Uhřínov 1, 516 01 Liberk – Uhřínov, Česko",
        maps: [{ label: "mapy.cz", url: "https://mapy.com/s/puzenurocu" }],
        info: "Ubytování je uhrazeno v ceně pronájmu areálu. Nemusíte si tak s tímto dělat starost.",
        guests: [
            {
                name: "Gabča a Standa",
                icons: [{ type: "postel" }, { type: "pokoj", number: 1 }],
            },
            {
                name: "Gabča, Radek, Radka, Marián",
                icons: [{ type: "postel" }, { type: "pokoj", number: 2 }],
            },
            {
                name: "Saša, Milan, Saška, Honza R., Venča, Honza S.",
                icons: [{ type: "postel" }, { type: "pokoj", number: 3 }],
            },
            {
                name: "Norinka, Deborka, Sašenka, Honzík",
                icons: [{ type: "karimatka" }, { type: "pokoj", number: 3 }],
            },
            {
                name: "Anežka + Henrika, Jindra, Jitka, Tomáš, Petra, Pavel, Pavla, Lída, Honza",
                icons: [{ type: "postel" }, { type: "pokoj", number: 4 }],
            },
            {
                name: "Honza Šikula, Vilém, Adam, Nella, Tonda, Domča",
                icons: [{ type: "karimatka" }, { type: "pokoj", number: 4 }],
            },
            {
                name: "Matěj, Dan",
                icons: [{ type: "karimatka" }],
                note: "Místnost v mezipatře",
            },
            {
                name: "Milada, Jirka, Jitka, Vlastík, Standa st.",
                icons: [{ type: "postel" }, { type: "pokoj", number: 5 }],
            },
            {
                name: "Dáša, Pepa ml., Věrka, Verča, David M.",
                icons: [{ type: "postel" }, { type: "pokoj", number: 6 }],
            },
            {
                name: "Lenka, Ondřej",
                icons: [{ type: "postel" }, { type: "pokoj", number: 7 }],
            },
            {
                name: "Babička a Děda Rouskovi",
                icons: [{ type: "postel" }, { type: "pokoj", number: 8 }],
            },
            {
                name: "Kamča, Pája, Pepa",
                icons: [{ type: "postel" }, { type: "pokoj", number: 9 }],
            },
            {
                name: "Martin",
                icons: [{ type: "karimatka" }, { type: "pokoj", number: 9 }],
            },
            {
                name: "Martin, Dáša, Klárka, Zdeněk",
                icons: [{ type: "postel" }, { type: "pokoj", number: 10 }],
            },
            {
                name: "Káťa + Elenka, Jirka",
                icons: [{ type: "postel" }, { type: "pokoj", number: 11 }],
            },
            {
                name: "Ježkovi",
                icons: [{ type: "stan" }],
            },
        ],
    },
    {
        name: "Chata Liebich",
        address: "Uhřínov 58 (mapy cz), ev. číslo 81(google mapy), 516 01 Liberk - Uhřínov",
        maps: [
            { label: "mapy.cz", url: "https://mapy.com/s/nuvukalopu" },
            { label: "google mapy", url: "https://maps.app.goo.gl/6aGiS1GTy7fay3SRA" },
        ],
        outdatedInfo: "560 Kč za osobu a noc.",
