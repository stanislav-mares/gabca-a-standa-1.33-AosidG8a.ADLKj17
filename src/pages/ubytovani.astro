---
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/BackButton.astro";
import GrainIcon from "../components/GrainIcon.astro";
import HouseColumn from "../components/HouseColumn.astro";
import PageHeading from "../components/PageHeading.astro";
import { slideTransition } from "../utils/transitions";

const heading = "Ubytování";

const intro = [
    `Na základě informací z dotazníku provedeme rozdělení ubytovacích kapacit. V jednom z domečků níže se zavčasu objeví
    tvoje / vaše jméno, kde budete ubytování. Můžete taky využít vyhledávání viz "Kde spím?".`,
    "Odvoz na ubytování zajištěn.",
    "Ubytování je na chatě Liebich a v Továrníkově vile bez snídaně. V neděli je možnost potkat se opět na Farním dvoře, případně se vydat rovnou domů.",
    "Rozvoz domů nezajišťujeme.",
];

// Konfigurace ubytování — hosty stačí doplnit/upravit tady.
// `maps` jsou sdílecí odkazy z mapy.com, stejně jako trasy na `svatebni-den`;
// u Liebicha přibývá i Google, protože obě mapy vedou dům pod jiným číslem.
const houses = [
    {
        name: "Farní dvůr",
        address: "Uhřínov 1, 516 01 Liberk – Uhřínov, Česko",
        maps: [{ label: "mapy.cz", url: "https://mapy.com/s/puzenurocu" }],
        info: "Ubytování je uhrazeno v ceně pronájmu areálu. Nemusíte si tak s tímto dělat starost.",
        guests: ["Gabča a Standa (novomanželský pokoj)"],
    },
    {
        name: "Chata Liebich",
        address: "Uhřínov 58 (mapy cz), ev. číslo 81(google mapy), 516 01 Liberk - Uhřínov",
        maps: [
            { label: "Mapy.cz", url: "https://mapy.com/s/nuvukalopu" },
            { label: "google mapy", url: "https://maps.app.goo.gl/6aGiS1GTy7fay3SRA" },
        ],
        info: "Cena 560 Kč za osobu a noc. ",
        guests: ["..."],
    },
    {
        name: "Továrníkova vila",
        address: "Skuhrov nad Bělou 93, 517 03 Skuhrov nad Bělou, Česko",
        maps: [{ label: "mapy.cz", url: "https://mapy.com/s/kubumorabu" }],
        info: "Cena 540 Kč za osobu a noc.",
        guests: ["..."],
    },
];
---

<Layout>
    <main
        class="h-dvh w-full pt-top bg-surface overflow-y-auto"
        transition:animate={slideTransition}
        transition:name="main-panel"
    >
        <section
            class="flex flex-col items-center px-gutter pb-[50vh] lg:pl-[calc(var(--spacing-backbtn)+var(--spacing-gutter))]"
        >
            <PageHeading text={heading} class="mb-heading" />
            <div
                class="w-full max-w-3xl flex flex-col gap-block mb-section"
                data-reveal
                style="--reveal-offset: 0s"
            >
                {intro.map((text) => <p class="paragraph">{text}</p>)}
            </div>
            <h2
                class="font-heading text-subheading text-accent mb-block"
                data-reveal
                style="--reveal-offset: 0.08s"
            >
                Kde spím?
            </h2>
            <div class="w-full max-w-[104rem] mb-section 2xl:grid 2xl:grid-cols-3 2xl:gap-section">
                <input
                    type="text"
                    id="guest-search"
                    placeholder="Jméno hosta"
                    autocomplete="off"
                    class="block w-full max-w-xs mx-auto 2xl:max-w-none 2xl:col-start-2 bg-transparent border-0 border-b border-black pb-2 text-center font-body text-ink placeholder:text-ink/40 focus:outline-none focus:border-accent transition-colors"
                    data-reveal
                    style="--reveal-offset: 0.14s"
                />
            </div>
            <div
                class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-3 gap-section w-full max-w-[104rem] items-start [&>:last-child]:md:max-2xl:col-span-2 [&>:last-child]:md:max-2xl:w-[calc(50%_-_var(--spacing-section)/2)] [&>:last-child]:md:max-2xl:justify-self-center"
                data-reveal
                style="--reveal-offset: 0.22s"
            >
                {houses.map((house) => <HouseColumn {...house} />)}
            </div>
            <GrainIcon />
        </section>

        <BackButton />
    </main>
</Layout>

<script>
    // Porovnávání bez ohledu na velikost písmen a diakritiku ("stastna" najde "Šťastná")
    function normalize(value: string): string {
        return value
            .toLocaleLowerCase("cs")
            .normalize("NFD")
            .replace(/\p{Diacritic}/gu, "");
    }

    function initGuestFilter() {
        const input = document.getElementById("guest-search");
        if (!(input instanceof HTMLInputElement)) return;

        const houses = Array.from(
            document.querySelectorAll<HTMLElement>("[data-house]"),
        ).map((house) => ({
            house,
            guests: Array.from(
                house.querySelectorAll<HTMLElement>("[data-guest]"),
            ).map((item) => ({ item, search: normalize(item.textContent ?? "") })),
        }));

        const applyFilter = () => {
            const query = normalize(input.value.trim());
            for (const { house, guests } of houses) {
                let visibleCount = 0;
                for (const { item, search } of guests) {
                    const match = search.includes(query);
                    item.classList.toggle("hidden", !match);
                    if (match) visibleCount++;
                }
                const empty = visibleCount === 0;
                house.classList.toggle("max-md:hidden", empty);
                house.classList.toggle("md:opacity-30", empty);
            }
        };

        input.addEventListener("input", applyFilter);
        applyFilter();
    }

    document.addEventListener("astro:page-load", initGuestFilter);
</script>
