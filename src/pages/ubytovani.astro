---
import Layout from "../layouts/Layout.astro";
import BackButton from "../components/BackButton.astro";
import GrainIcon from "../components/GrainIcon.astro";
import GuestIcon from "../components/GuestIcon.astro";
import GuestNote from "../components/GuestNote.astro";
import IconExplanation from "../components/IconExplanation.astro";
import HouseColumn, { type Guest } from "../components/HouseColumn.astro";
import PageHeading from "../components/PageHeading.astro";
import { slideTransition } from "../utils/transitions";

const heading = "Ubytování";

const intro = [
    `Na základě informací z dotazníku provedeme rozdělení ubytovacích kapacit. V jednom z domečků níže se zavčasu objeví
    tvoje / vaše jméno, kde budete ubytování. Můžete taky využít vyhledávání viz "Kde spím?".`,
    "Odvoz na ubytování zajištěn.",
    "Ubytování je na chatě Liebich a v Továrníkově vile bez snídaně. V neděli je možnost potkat se opět na Farním dvoře, případně se vydat rovnou domů.",
    "Rozvoz domů nezajišťujeme.",
];

// Konfigurace ubytování — hosty stačí doplnit/upravit tady.
// `maps` jsou sdílecí odkazy z mapy.com, stejně jako trasy na `svatebni-den`;
// u Liebicha přibývá i Google, protože obě mapy vedou dům pod jiným číslem.
