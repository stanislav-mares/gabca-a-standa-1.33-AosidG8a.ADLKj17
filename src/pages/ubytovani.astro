---

<Layout>
    <main
        class="h-dvh w-full pt-top bg-surface overflow-y-auto"
        transition:animate={slideTransition}
        transition:name="main-panel"
    >
        <section
            class="flex flex-col items-center px-gutter pb-[50vh] lg:pl-[calc(var(--spacing-backbtn)+var(--spacing-gutter))]"
        >
            <PageHeading text={heading} class="mb-heading" />
            <div
                class="w-full max-w-3xl flex flex-col gap-block mb-section"
                data-reveal
                style="--reveal-offset: 0s"
            >
                {intro.map((text) => <p class="paragraph">{text}</p>)}
            </div>
            <h2
                class="font-heading text-subheading text-accent mb-block"
                data-reveal
                style="--reveal-offset: 0.08s"
            >
                Kde spím?
            </h2>
            <div class="w-full max-w-[104rem] mb-block 2xl:grid 2xl:grid-cols-3 2xl:gap-section">
                <input
                    type="text"
                    id="guest-search"
                    placeholder="Jméno hosta"
                    autocomplete="off"
                    class="block w-full max-w-xs mx-auto 2xl:max-w-none 2xl:col-start-2 bg-transparent border-0 border-b border-black pb-2 text-center font-body text-ink placeholder:text-ink/40 focus:outline-none focus:border-accent transition-colors"
                    data-reveal
                    style="--reveal-offset: 0.14s"
                />
            </div>
            <p
                class="max-w-md text-center font-body text-body text-text mb-section"
                data-reveal
                style="--reveal-offset: 0.18s"
            >
                Pro bližší informace se podívej na{" "}
                <button
                    type="button"
                    data-legend-open
                    class="underline decoration-accent underline-offset-4 hover:bg-hover transition-colors cursor-pointer"
                >
                    Vysvětlivky k ikonám
                </button>{" "}
                nebo klikni na příslušnou ikonu u řádku s tvým jménem.
            </p>
            <dialog
                id="icon-legend-dialog"
                class="fixed inset-0 m-auto h-fit max-h-[85vh] w-[calc(100%-2*var(--spacing-gutter))] max-w-lg overflow-y-auto rounded-lg border-0 bg-surface p-block text-text shadow-xl backdrop:bg-ink/50"
            >
                <div class="flex items-center justify-between gap-block mb-block">
                    <h3 class="font-heading text-subheading-sm text-accent">Vysvětlivky k ikonám</h3>
                    <button
                        type="button"
                        data-legend-close
                        aria-label="Zavřít"
                        class="shrink-0 text-2xl leading-none text-ink hover:text-accent transition-colors cursor-pointer"
                    >
                        &times;
                    </button>
                </div>
                <ul class="grid grid-cols-[auto_1fr] items-center justify-items-center gap-x-tight gap-y-tight font-body text-body text-text">
                    {/* `contents` zruší box `<li>`, takže jeho děti (ikona + text) jdou
                        přímo do gridu — sloupec ikon má pak společnou pevnou šířku a
                        různě velké ikony (např. menší pokoj) se v něm vycentrují, takže
                        drží pod sebou. */}
                    <li class="contents">
                        <GuestIcon type="postel" class="text-[2em]" tooltip={false} />
                        <span class="justify-self-start"><IconExplanation type="postel" /></span>
                    </li>
                    <li class="contents">
                        <GuestIcon type="karimatka" class="text-[2em]" tooltip={false} />
                        <span class="justify-self-start"><IconExplanation type="karimatka" /></span>
                    </li>
                    <li class="contents">
                        <GuestIcon type="stan" class="text-[2em]" tooltip={false} />
                        <span class="justify-self-start"><IconExplanation type="stan" /></span>
                    </li>
                    <li class="contents">
                        <GuestIcon type="pokoj" class="self-start text-[1.6em]" tooltip={false} />
                        <div class="justify-self-start"><IconExplanation type="pokoj" /></div>
                    </li>
                    <li class="contents">
                        <GuestNote note="" class="text-[1.8em]" tooltip={false}/>
                        <span class="justify-self-start">Poznámka</span>
                    </li>
                </ul>
            </dialog>
            <div
                class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-3 gap-section w-full max-w-[104rem] items-start [&>:last-child]:md:max-2xl:col-span-2 [&>:last-child]:md:max-2xl:w-[calc(50%_-_var(--spacing-section)/2)] [&>:last-child]:md:max-2xl:justify-self-center"
                data-reveal
                style="--reveal-offset: 0.22s"
            >
                {houses.map((house) => <HouseColumn {...house} />)}
            </div>
            <GrainIcon />
        </section>

        <BackButton />
    </main>
</Layout>

<script>
    // Porovnávání bez ohledu na velikost písmen a diakritiku ("stastna" najde "Šťastná")
    function normalize(value: string): string {
        return value
            .toLocaleLowerCase("cs")
            .normalize("NFD")
            .replace(/\p{Diacritic}/gu, "");
    }

    function initGuestFilter() {
        const input = document.getElementById("guest-search");
        if (!(input instanceof HTMLInputElement)) return;

        const houses = Array.from(
            document.querySelectorAll<HTMLElement>("[data-house]"),
        ).map((house) => ({
            house,
            guests: Array.from(
                house.querySelectorAll<HTMLElement>("[data-guest]"),
            ).map((item) => {
                // Hledá se jen podle jména, ne podle textu ikonky pokoje
                // (číslo/otazník by jinak filtr zkreslovalo).
                const nameEl = item.querySelector<HTMLElement>("[data-guest-name]");
                return { item, search: normalize((nameEl ?? item).textContent ?? "") };
            }),
        }));

        const applyFilter = () => {
            const query = normalize(input.value.trim());
            for (const { house, guests } of houses) {
                let visibleCount = 0;
                for (const { item, search } of guests) {
                    const match = search.includes(query);
                    item.classList.toggle("hidden", !match);
                    if (match) visibleCount++;
                }
                const empty = visibleCount === 0;
                house.classList.toggle("max-md:hidden", empty);
                house.classList.toggle("md:opacity-30", empty);
            }
        };

        input.addEventListener("input", applyFilter);
        applyFilter();
    }

    document.addEventListener("astro:page-load", initGuestFilter);

    function initIconLegendDialog() {
        const dialog = document.getElementById("icon-legend-dialog");
        if (!(dialog instanceof HTMLDialogElement)) return;

        document
            .querySelector("[data-legend-open]")
            ?.addEventListener("click", () => dialog.showModal());

        dialog
            .querySelector("[data-legend-close]")
            ?.addEventListener("click", () => dialog.close());

        // Klik mimo obsah dopadne přímo na <dialog> (tvoří i plochu za obsahem),
        // klik na potomka uvnitř se sem díky bublání nedostane s jiným cílem.
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
        });
    }

    document.addEventListener("astro:page-load", initIconLegendDialog);
</script>
